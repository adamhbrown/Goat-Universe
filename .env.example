BACKEND_MODE=local
APP_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:8787
LOCAL_DATABASE_PATH=.local/postgres

# Separate staging/dev Supabase project. Never use the production ref in development.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only billing key; not used for user competition/CRM requests.
SUPABASE_BILLING_SECRET_KEY=
# Enable only after staging email templates and provider are verified.
AUTH_EMAIL_ENABLED=false
PRODUCTION_LAUNCH_APPROVED=false
PAYMENTS_ENABLED=false
PAYMENT_LAUNCH_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APPROVED_PRICES={}
